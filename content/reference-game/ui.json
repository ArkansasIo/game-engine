{
  "theme": {
    "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif",
    "pageBackground": "#0d1220",
    "panel": "#121b2d",
    "panelBorder": "#3a4c72",
    "text": "#eff4ff",
    "accent": "#9fc6ff",
    "health": "#f05b75"
  },
  "hud": { "slots": ["health", "level", "skills", "quest-tracker"] },
  "pauseMenu": {
    "title": "Menu",
    "tabs": [
      { "id": "character", "label": "Character", "submenus": [
        { "id": "status", "label": "Status", "description": "Vitals, party, and rank" },
        { "id": "party", "label": "Party", "description": "Group composition and support" }
      ] },
      { "id": "inventory", "label": "Inventory", "submenus": [
        { "id": "items", "label": "Items", "description": "Consumables and quest inventory" },
        { "id": "equipment", "label": "Equipment", "description": "Weapons, armor, and gear" }
      ] },
      { "id": "quests", "label": "Quests", "submenus": [
        { "id": "journal", "label": "Journal", "description": "Current missions and goals" },
        { "id": "log", "label": "Adventure Log", "description": "Current location and objective" }
      ] },
      { "id": "system", "label": "System", "submenus": [
        { "id": "save", "label": "Save", "description": "Save your progress in this browser" },
        { "id": "load", "label": "Load", "description": "Load saved progress from this browser" },
        { "id": "controls", "label": "Controls", "description": "View keyboard controls" }
      ] }
    ]
  },
  "battle": {
    "background": {
      "lowerImage": "battle/rpg-maker-mz/battlebacks1/Grassland.png",
      "upperImage": "battle/rpg-maker-mz/battlebacks2/Grassland.png"
    }
  }
}
